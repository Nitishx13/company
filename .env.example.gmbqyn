# -----------------------------------------------------------------------------
# GMBQYN backend
# -----------------------------------------------------------------------------
# Leave GMBQYN_API_URL empty to run the module against the local demo adapter
# (data is kept in browser localStorage under the key gmbqyn_db_v1).
#
# Set it to your Laravel origin to switch every screen over to the real API.
# The app appends /api/v1 to this value, so point it at the site root, e.g.
#   GMBQYN_API_URL="https://api.gmbqyn.in"
# -----------------------------------------------------------------------------
GMBQYN_API_URL=""
NEXT_PUBLIC_GMBQYN_API_URL=""
