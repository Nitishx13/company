# -----------------------------------------------------------------------------
# Copy to .env.local for local development, or set these in the Vercel dashboard
# (Project > Settings > Environment Variables) for deployments.
#   cp .env.example .env.local
#
# NEVER commit a filled-in .env.local. It is gitignored.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Supabase - required by the Pinaqyn marketing site (app/(marketing)/...)
# -----------------------------------------------------------------------------
# Service-role key bypasses row level security. Server-side only.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Anon key is safe to expose to the browser; it is inlined at build time.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# -----------------------------------------------------------------------------
# Supabase - direct Postgres connection, only if you use the Prisma scripts
# -----------------------------------------------------------------------------
# POSTGRES_URL_NON_POOLING=""
# POSTGRES_PRISMA_URL=""
# POSTGRES_HOST=""
# DIRECT_URL=""

# -----------------------------------------------------------------------------
# GMBQYN backend - see .env.example.gmbqyn for full notes
# -----------------------------------------------------------------------------
# Leave both empty to run the whole GMBQYN module on the local demo adapter
# (data persists in browser localStorage). No backend is required to deploy.
GMBQYN_API_URL=""
NEXT_PUBLIC_GMBQYN_API_URL=""
